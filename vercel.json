{
  "trailingSlash": false,
  "redirects": [
    { "source": "/preise", "destination": "/", "permanent": false },
    { "source": "/en/pricing", "destination": "/en", "permanent": false },
    { "source": "/impressum", "destination": "/imprint", "permanent": true },
    { "source": "/datenschutz", "destination": "/privacy", "permanent": true },
    { "source": "/dresden", "destination": "/tom-nowak", "permanent": true },
    { "source": "/dresden/", "destination": "/tom-nowak", "permanent": true },
    { "source": "/tom.nowak", "destination": "/tom-nowak", "permanent": true },
    { "source": "/tom.nowak/", "destination": "/tom-nowak", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
