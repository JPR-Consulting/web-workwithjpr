{
  "trailingSlash": false,
  "redirects": [
    { "source": "/impressum", "destination": "/imprint", "permanent": true },
    { "source": "/datenschutz", "destination": "/privacy", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
